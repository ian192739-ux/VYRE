-- AUTO APUNTADO
local function GetClosestPlayer()
    local closest = nil
    local shortestDistance = math.huge
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player and target.Character then
            local character = target.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local head = character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local distance = (
                    Camera.CFrame.Position - head.Position
                ).Magnitude

                if distance <= AIM_MAX_DISTANCE then
                    local screenPosition, visible =
                        Camera:WorldToViewportPoint(head.Position)

                    if visible and screenPosition.Z > 0 then
                        local screenDistance = (
                            Vector2.new(screenPosition.X, screenPosition.Y)
                            - center
                        ).Magnitude

                        if screenDistance < shortestDistance then
                            shortestDistance = screenDistance
                            closest = head
                        end
                    end
                end
            end
        end
    end

    return closest
end

AimButton.MouseButton1Click:Connect(function()
    AimEnabled = not AimEnabled

    AimButton.Text = AimEnabled and "ON" or "OFF"
    AimButton.BackgroundColor3 =
        AimEnabled and PURPLE or Color3.fromRGB(60, 60, 75)
end)

RunService:BindToRenderStep(
    "VYRE_CAMERA_AIM",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not AimEnabled then return end
        if not Camera or not Camera.Parent then
            Camera = workspace.CurrentCamera
            return
        end

        local target = GetClosestPlayer()

        if target then
            local desired = CFrame.lookAt(
                Camera.CFrame.Position,
                target.Position
            )

            Camera.CFrame = Camera.CFrame:Lerp(
                desired,
                AIM_SMOOTHNESS
            )
        end
    end
)

-- ESP OVERHEAD
local ESPObjects = {}

local function RemoveESP(target)
    if ESPObjects[target] then
        ESPObjects[target]:Destroy()
        ESPObjects[target] = nil
    end
end

local function CreateESP(target)
    if target == Player then return end

    RemoveESP(target)

    local character = target.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "VYRE_Overhead"
    Billboard.Adornee = head
    Billboard.Size = UDim2.fromOffset(180, 45)
    Billboard.StudsOffset = Vector3.new(0, 2.7, 0)
    Billboard.AlwaysOnTop = true
    Billboard.MaxDistance = 500
    Billboard.Parent = PlayerGui

    local Text = Instance.new("TextLabel")
    Text.Size = UDim2.fromScale(1, 1)
    Text.BackgroundTransparency = 1
    Text.TextColor3 = Color3.fromRGB(210, 175, 255)
    Text.TextStrokeTransparency = 0.25
    Text.TextStrokeColor3 = Color3.new(0, 0, 0)
    Text.Font = Enum.Font.GothamBold
    Text.TextSize = 12
    Text.Parent = Billboard

    ESPObjects[target] = Billboard

    local function Update()
        if not Billboard.Parent then return end

        local tool = character:FindFirstChildOfClass("Tool")
        local toolName = tool and tool.Name or "Sin herramienta"

        Text.Text = target.Name .. "\n" .. toolName
    end

    Update()
end

local function RefreshESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player then
            if target.Character then
                local head = target.Character:FindFirstChild("Head")

                if head then
                    local current = ESPObjects[target]

                    if not current or current.Adornee ~= head then
                        CreateESP(target)
                    else
                        local text = current:FindFirstChildOfClass(
                            "TextLabel"
                        )

                        if text then
                            local tool = target.Character:FindFirstChildOfClass("Tool")
                            text.Text = target.Name .. "\n" ..
                                (tool and tool.Name or "Sin herramienta")
                        end
                    end
                end
            else
                RemoveESP(target)
            end
        end
    end
end

ESPButton.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled

    ESPButton.Text = ESPEnabled and "ON" or "OFF"
    ESPButton.BackgroundColor3 =
        ESPEnabled and PURPLE or Color3.fromRGB(60, 60, 75)

    if not ESPEnabled then
        for target in pairs(ESPObjects) do
            RemoveESP(target)
        end
    else
        RefreshESP()
    end
end)

